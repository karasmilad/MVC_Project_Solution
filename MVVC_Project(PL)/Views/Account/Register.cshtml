@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}
<!-- main -->
<div class="main-w3layouts wrapper">
	<h1>Creative SignUp Form</h1>
	<div class="main-agileinfo">
		<div class="agileits-top">
			<form asp-action="Register" asp-controller="Account" method="post">
				<div asp-validation-summary="ModelOnly" class="text-danger"></div>
				<input asp-for="UserName" placeholder="UserName" required="">
				<span asp-validation-for="UserName" class="text-danger"></span>
				<br />
				<input asp-for="FirstName" placeholder="FirstName" required="">
				<span asp-validation-for="FirstName"></span>
				<br />
				<input asp-for="LastName" placeholder="LastName" required="">
				<span asp-validation-for="LastName"></span>
				<br />
				<input asp-for="Email" placeholder="Email" required="">
				<span asp-validation-for="Email"></span>				
				<br />
				<input asp-for="Password" placeholder="Password" required="">
				<span asp-validation-for="Password"></span>
				<br />
				<input asp-for="ConfirmPassword" placeholder="ConfirmPassword" required="">
				<span asp-validation-for="ConfirmPassword"></span>
				<div class="wthree-text">
					<label class="anim">
						<input asp-for="IsAgree" class="checkbox">
						<span>I Agree To The Terms & Conditions</span>
					</label>
					<div class="clear"> </div>
				</div>
				<input type="submit" value="SIGNUP">
			</form>
			<p>Do Have an Account? <a asp-action="Login"> Login Now!</a></p>
		</div>
	</div>
	<!-- copyright -->
	<div class="colorlibcopy-agile">
		<p>© 2018 Colorlib Signup Form. All rights reserved | Design by <a href="https://colorlib.com/" target="_blank">Colorlib</a></p>
	</div>
	<!-- //copyright -->
	<ul class="colorlib-bubbles">
		<li></li>
		<li></li>
		<li></li>
		<li></li>
		<li></li>
		<li></li>
		<li></li>
		<li></li>
		<li></li>
		<li></li>
	</ul>
</div>
<!-- //main -->

